{
  "kind": "collectionType",
  "collectionName": "transactions",
  "info": {
    "singularName": "transaction",
    "pluralName": "transactions",
    "displayName": "Transaction"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "message": {
      "type": "string",
      "default": "Amount changed",
      "required": true
    },
    "date": {
      "type": "date"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "deposit",
        "withdrawal"
      ]
    },
    "amount": {
      "type": "decimal",
      "required": true,
      "min": 1
    }
  }
}
